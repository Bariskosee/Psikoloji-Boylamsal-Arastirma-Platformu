# The two Next.js frontends. One Dockerfile, selected by the APP build argument.
#
# ── Why `output: "standalone"` ──────────────────────────────────────────────
# Next traces exactly the files the server needs and emits a folder with its
# own minimal `node_modules`. Without it, running `next start` in a container
# means shipping the entire workspace dependency tree — hundreds of megabytes
# of build-time tooling on a machine whose whole appeal is that it is free.
#
# ── The build argument that is not like the others ──────────────────────────
# `NEXT_PUBLIC_API_URL` is inlined into the client bundle AT BUILD TIME. It is
# a build arg rather than a runtime environment variable because that is what
# it actually is; passing it at run time looks like it works and silently
# leaves the browser calling localhost. Changing it requires a rebuild.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

FROM base AS build
ARG APP
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm build --filter=@lpr/${APP}...
# Not every app has static assets — the researcher dashboard has none — and a
# COPY of a missing path fails the build rather than being skipped.
RUN mkdir -p /repo/apps/${APP}/public

FROM base AS runtime
ARG APP
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S lpr && adduser -S lpr -G lpr
WORKDIR /app
# The standalone server, and the two asset trees it does not inline.
COPY --from=build --chown=lpr:lpr /repo/apps/${APP}/.next/standalone ./
COPY --from=build --chown=lpr:lpr /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=lpr:lpr /repo/apps/${APP}/public ./apps/${APP}/public
USER lpr
ENV APP_DIR=apps/${APP}
# Standalone preserves the workspace layout, so the server sits under its app.
CMD ["sh", "-c", "node ${APP_DIR}/server.js"]
