# Oracle single-VM production template. PLACEHOLDERS ONLY; never commit the
# filled .env.production file. Generate passwords with `openssl rand -hex 32`.

# bootstrap-env.sh replaces these together. participant mode is valid only with
# stable DNS hostnames or an OCI reserved public IP. smoke/ephemeral-ip is for
# deployment checks only: DO NOT ENROLL REAL PARTICIPANTS because an IP change
# invalidates continuity cookies and every existing push subscription.
DEPLOYMENT_MODE=smoke
ORIGIN_MODE=ephemeral-ip

POSTGRES_USER=lpr_admin
POSTGRES_PASSWORD=CHANGE_ME_hex_32
POSTGRES_DB=lpr

# API and worker use this non-superuser login. Migrations/backups use the
# bootstrap account above.
APP_DATABASE_USER=lpr_app
APP_DATABASE_PASSWORD=CHANGE_ME_different_hex_32

# Hostnames only, with no scheme or path. The example sslip.io names are safe
# placeholders for smoke mode, not stable participant origins.
API_HOST=api.203-0-113-10.sslip.io
PARTICIPANT_HOST=participant.203-0-113-10.sslip.io
RESEARCHER_HOST=researcher.203-0-113-10.sslip.io

# Required by Caddy for ACME certificate expiry and account notifications.
ACME_EMAIL=

SESSION_SECRET=CHANGE_ME_openssl_rand_hex_48

# Keep this pair stable for the life of the study. A changed public key
# invalidates every participant's existing push subscription.
VAPID_PUBLIC_KEY=CHANGE_ME_public
VAPID_PRIVATE_KEY=CHANGE_ME_private
VAPID_SUBJECT=https://participant.203-0-113-10.sslip.io

# Empty SMTP is a supported smoke-test mode; reset links are logged server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=

SENTRY_DSN=
LOG_LEVEL=info
SWEEP_INTERVAL_SECONDS=60
WORKER_ID=lpr-worker-1
