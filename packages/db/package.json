{
  "name": "@lpr/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, database connectivity, and the pg-boss job queue. Server-side only \u2014 never imported by a frontend.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:up": "drizzle-kit migrate",
    "migrate:check": "drizzle-kit check"
  },
  "dependencies": {
    "@lpr/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6"
  },
  "devDependencies": {
    "@lpr/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
