{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Next.js applications. Bundler resolution, JSX preserved for the Next compiler.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "declaration": false,
    "declarationMap": false
  }
}
