# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Test output
coverage/
test-results/
playwright-report/
.playwright/
# Scratch output from the Playwright MCP server — page snapshots and console
# logs written on every navigation. Regenerated on demand and named by
# timestamp, so it accumulates fast and none of it is worth versioning.
# Evidence worth keeping is copied into docs/qa/evidence/ by hand.
.playwright-mcp/

# Environment — NEVER commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example
!infrastructure/oracle/.env.production.example

# Secrets and keys
*.pem
*.key
*.p8
vapid.json
service-account*.json

# Local database volumes
.postgres-data/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
infrastructure/compose/backups/
infrastructure/oracle/backups/
