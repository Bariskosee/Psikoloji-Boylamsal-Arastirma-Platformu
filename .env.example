# Local development only. The deployed configuration lives in
# `infrastructure/compose/.env.production.example` (ADR-012) — copy THAT one
# to `.env.production` for a server, not this file.
# ─────────────────────────────────────────────────────────────────────────────
# Longitudinal Psychology Research Platform — environment template
#
# PLACEHOLDERS ONLY. Never commit real values (NFR-16, AGENT.md §5).
# Copy to .env for local development:   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://lpr:lpr_local_dev_only@localhost:5432/lpr

# The analytics/export role needs NO connection string of its own.
#
# `app_analytics` is a NOLOGIN group role (migration 0000). Every dashboard and
# export query uses DATABASE_URL and drops to it with `SET ROLE`, which enforces
# "SELECT on research, nothing on identity" at the database (NFR-03, ADR-003)
# from one credential. A second password would be one more thing to provision,
# rotate, and leave stale.
#
# In production the two NOLOGIN group roles must exist AND the login user must
# be a member of them, or the analytics connection is refused outright — the
# role travels in the startup packet, so this is not a degraded query, it is a
# failed connection and every dashboard breaks at once.
#
# Migration 0009 grants the membership. Creating the roles needs CREATEROLE,
# which a managed provider's user often lacks; `docs/runbooks/first-deploy.md`
# §3 has the two lines a database administrator runs once.

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001

# Origins allowed to call the API with credentials.
PARTICIPANT_ORIGIN=http://localhost:3000
RESEARCHER_ORIGIN=http://localhost:3002

# ── Frontends ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Sessions and secrets (Phase 2) ───────────────────────────────────────────
# Required — the API refuses to start without it. Keys the salted IP hashes in
# audit rows and sessions, so rotating it makes historic hashes uncorrelatable.
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Absolute session lifetime in hours; a session ends after this however active.
SESSION_ABSOLUTE_TTL_HOURS=12
# Idle timeout in minutes; an unused session is rejected on its next use.
SESSION_IDLE_TIMEOUT_MINUTES=120

# Secure cookies. Unset means "on outside development" — off locally because
# Safari refuses Secure cookies over http://localhost.
# COOKIE_SECURE=true

# Login rate limit (STRUCTURE.md §11.5). Applied per email AND per IP.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ── Web Push / VAPID (Phase 8) ───────────────────────────────────────────────
# Generate with: pnpm dlx web-push generate-vapid-keys
# The PRIVATE key is a secret and must never reach the client (ADR-006).
#
# Leave BOTH empty to run without push. The API refuses to start with only one
# of them set: a public key with no private one produces subscriptions that can
# never be sent to, and nothing would report it until Phase 9's first reminder.
#
# The placeholders below are deliberately distinct. Two identical placeholders
# make "the public key was served and the private one was not" indistinguishable.
VAPID_PUBLIC_KEY=CHANGE_ME_public
VAPID_PRIVATE_KEY=CHANGE_ME_private
VAPID_SUBJECT=mailto:research@example.org

# ── Outbound email (Phase 12) ────────────────────────────────────────────────
# Used for ONE message: the researcher password-reset link. Nothing is ever
# emailed to participants — the platform holds no participant email address at
# all, and that is deliberate (FR-08).
#
# Leaving SMTP_HOST empty is a supported configuration: the reset flow still
# works end to end and the message is written to the API log instead of sent,
# which is what lets a team pilot before institutional mail relaying is
# arranged. Startup warns when it is empty, so a deployment cannot believe it
# is sending mail while it is not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS on 465; leave false for STARTTLS on 587.
SMTP_SECURE=false
MAIL_FROM=noreply@example.org

# Password reset requests per hour, per account AND per IP.
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Participant enrollments per hour from one IP address.
# Recruitment happens by QR code, so a whole cohort normally enrols from one
# institutional address within minutes. Raise it for larger sessions.
ENROLL_RATE_LIMIT_MAX=60

# ── Observability ────────────────────────────────────────────────────────────
# Leave empty to disable Sentry locally.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# ── Worker ───────────────────────────────────────────────────────────────────
# Reconciliation sweep interval in seconds (ADR-005). Do not raise casually:
# this is the upper bound on scheduling recovery time after an outage.
SWEEP_INTERVAL_SECONDS=60
# This worker instance's name in research.system_heartbeats (ADR-005).
# Must be STABLE across restarts and DISTINCT between replicas: an id that
# changes on restart leaves permanently-stale orphan rows, and an id shared by
# two replicas hides either one going down. Defaults to the hostname, which is
# what a container platform assigns per instance — set it explicitly only where
# the hostname is random per start.
# WORKER_ID=worker-1
